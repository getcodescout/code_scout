package view

import (
	"fmt"
	"github.com/google/uuid"
	"github.com/getcodescout/code_scout/internal/domain"
)

type NetworkDetailData struct {
	User *domain.User
	ProjectID uuid.UUID
	Project   *domain.Project
	RequestID uuid.UUID
	// Logs is every phase of the call and the first LinkedLogLimit of the
	// app's own logs about it. LinkedTotal counts all of the app's.
	Logs        []domain.Log
	LinkedTotal int
}

func (d NetworkDetailData) shell() ProjectShellData {
	// A network call belongs to the log viewer, so Logs stays active.
	return ProjectShellData{User: d.User, ProjectID: d.ProjectID, Project: d.Project, Active: "logs"}
}

templ NetworkDetailPage(data NetworkDetailData) {
	@ProjectShell(data.shell()) {
				{{ phases, linked := domain.SplitCallLogs(data.Logs) }}
				<!-- Back to the list this request came from -->
				<a
					href={ templ.SafeURL(fmt.Sprintf("/project/%s/logs", data.ProjectID)) }
					class="text-cs-muted hover:text-white text-sm transition-colors mb-4 inline-flex items-center gap-1"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
					Back to Logs
				</a>

				<!-- Request Header -->
				<div class="mt-2 mb-6">
					if len(phases) == 0 && len(linked) > 0 {
						<h1 class="text-xl font-bold text-white">Call not captured</h1>
						<p class="text-cs-muted text-sm font-mono mt-1">request { data.RequestID.String() }</p>
					} else {
						<h1 class="text-xl font-bold text-white">Network Request</h1>
						<p class="text-cs-muted text-sm font-mono mt-1">{ data.RequestID.String() }</p>
					}
				</div>

				if len(linked) > 0 {
					<section data-linked-logs aria-label="Logged by the app" class="mb-6 rounded-lg border border-cs-border px-4 pb-3 pt-3">
						<div class="flex items-baseline justify-between gap-3">
							<h2 class="flex items-baseline gap-2 text-xs font-semibold uppercase tracking-wider text-cs-muted">
								Logged by the app
								@linkedLogsCount(len(linked), data.LinkedTotal)
							</h2>
							@requestLogsLink(data.ProjectID, data.RequestID)
						</div>
						@linkedLogRows(linked)
					</section>
				}

				if len(phases) == 0 && len(linked) > 0 {
					<p data-call-not-captured class="rounded-lg border border-cs-border p-5 text-sm leading-relaxed text-cs-muted">{ domain.CallNotCaptured }</p>
				} else if len(phases) > 0 {
					<!-- Tab Bar. No card of its own: the shell's content area is
					     already one, and a second would frame the whole page twice. -->
					<div id="phase-tabs">
						<div class="flex border-b border-cs-border">
							for i, log := range phases {
								<button
									class={ "px-5 py-3 text-sm font-semibold transition-colors border-b-2",
										tabActiveClass(i == 0) }
									data-target={ fmt.Sprintf("tab-%d", i) }
									onclick="switchTab(this, this.getAttribute('data-target'))"
								>
									{ phaseLabel(log.CallPhase) }
								</button>
							}
						</div>

						<!-- Tab Panels -->
						for i, log := range phases {
							<div
								id={ fmt.Sprintf("tab-%d", i) }
								class={ "p-5", tabVisibility(i == 0) }
							>
								<!-- Phase Info -->
								<div class="flex items-center gap-3 mb-4">
									@LogLevelBadge(log.Level)
									<span class="font-mono text-xs text-cs-muted">
										{ fmtTime(log.TimeStamp, TimeMillis) }
									</span>
								</div>

								<!-- Message -->
								<p class="text-sm text-white mb-4">{ log.Message }</p>

								if log.Error != nil && *log.Error != "" {
									<div class="mb-4">
										<h3 class="text-xs font-semibold text-cs-muted uppercase tracking-wider mb-2">Error</h3>
										<pre class="font-mono text-xs text-red-400 bg-chinese-black border border-cs-border rounded-lg p-4 whitespace-pre-wrap">{ *log.Error }</pre>
									</div>
								}

								if log.Metadata != nil {
									<div class="mb-4">
										<h3 class="text-xs font-semibold text-cs-muted uppercase tracking-wider mb-2">Details</h3>
										<pre class="font-mono text-xs text-cs-muted bg-chinese-black border border-cs-border rounded-lg p-4 whitespace-pre-wrap overflow-x-auto">{ prettyJSON(*log.Metadata) }</pre>
									</div>
								}

								if log.StackTrace != nil {
									<div>
										<h3 class="text-xs font-semibold text-cs-muted uppercase tracking-wider mb-2">Stack Trace</h3>
										<pre class="font-mono text-xs text-cs-muted bg-chinese-black border border-cs-border rounded-lg p-4 whitespace-pre-wrap max-h-[300px] overflow-y-auto">{ string(*log.StackTrace) }</pre>
									</div>
								}
							</div>
						}
					</div>
				} else {
					<div class="flex flex-col items-center justify-center py-20 text-center">
						<p class="text-cs-muted text-sm">Request not found.</p>
						<a
							href={ templ.SafeURL(fmt.Sprintf("/project/%s/logs", data.ProjectID)) }
							class="text-cs-primary text-sm mt-2 hover:underline"
						>
							Back to logs
						</a>
					</div>
				}
		<script>
			function switchTab(btn, panelId) {
				// Deactivate all tabs
				btn.parentElement.querySelectorAll('button').forEach(function(b) {
					b.classList.remove('border-b-cs-primary', 'text-cs-primary');
					b.classList.add('border-b-transparent', 'text-cs-muted');
				});
				// Activate clicked tab
				btn.classList.remove('border-b-transparent', 'text-cs-muted');
				btn.classList.add('border-b-cs-primary', 'text-cs-primary');
				// Hide all panels
				// Scoped by id, not by a layout class: the wrapper used to be a
				// card and closest('.rounded-xl') would now climb to the shell.
				var panels = document.getElementById('phase-tabs').querySelectorAll('[id^="tab-"]');
				panels.forEach(function(p) { p.classList.add('hidden'); });
				// Show target panel
				document.getElementById(panelId).classList.remove('hidden');
			}
		</script>
	}
}

templ SparklineStats(stats *domain.LogStatsResult) {
	if stats != nil {
		<div class="flex items-end gap-[2px] h-8 mt-1">
			for _, bucket := range stats.Buckets {
				if bucket.ErrorCount > 0 {
					<div
						class="flex-1 bg-[#F85149] rounded-t-sm opacity-70 min-h-[2px]"
						style={ fmt.Sprintf("height: %d%%", sparklineHeight(bucket.TotalCount, stats)) }
					></div>
				} else {
					<div
						class="flex-1 bg-cs-primary rounded-t-sm opacity-50 min-h-[2px]"
						style={ fmt.Sprintf("height: %d%%", sparklineHeight(bucket.TotalCount, stats)) }
					></div>
				}
			}
		</div>
		<div class="flex justify-between text-[11px] text-cs-muted mt-0.5">
			<span>{ fmt.Sprintf("%d logs / 24h", stats.TotalLogs) }</span>
			if stats.TotalErrors > 0 {
				<span class="text-[#F85149]">{ fmt.Sprintf("%d errors", stats.TotalErrors) }</span>
			} else {
				<span>0 errors</span>
			}
		</div>
	}
}

func phaseLabel(phase *domain.CallPhase) string {
	if phase == nil {
		return "Unknown"
	}
	switch *phase {
	case domain.CallPhaseRequest:
		return "Request"
	case domain.CallPhaseResponse:
		return "Response"
	case domain.CallPhaseError:
		return "Error"
	default:
		return string(*phase)
	}
}

func tabActiveClass(active bool) string {
	if active {
		return "border-b-cs-primary text-cs-primary"
	}
	return "border-b-transparent text-cs-muted hover:text-white"
}

func tabVisibility(visible bool) string {
	if visible {
		return ""
	}
	return "hidden"
}

func sparklineHeight(count int64, stats *domain.LogStatsResult) int {
	if stats == nil || len(stats.Buckets) == 0 {
		return 2
	}
	var max int64
	for _, b := range stats.Buckets {
		if b.TotalCount > max {
			max = b.TotalCount
		}
	}
	if max == 0 {
		return 2
	}
	pct := int(float64(count) / float64(max) * 100)
	if pct < 2 {
		pct = 2
	}
	return pct
}
