package view

import (
	"fmt"
	"strings"
	"time"

	"github.com/google/uuid"
	"github.com/getcodescout/code_scout/internal/domain"
)

// The Network screen, following the prototype's s-network: the list on the
// left, the selected call inspected on the right.
//
// HTMX, in one paragraph. Two interactions here, and they are deliberately
// different. The toolbar is an ordinary GET form — filtering changes the whole
// list, so a normal page load is the right thing and needs no JavaScript at
// all. Selecting a row is not: the prototype's requirement is that inspecting
// a call does not navigate away, so each row does hx-get and swaps only the
// detail pane. hx-push-url still puts the selection in the address bar, so the
// URL stays shareable even though the page never reloaded.

type NetworkData struct {
	User      *domain.User
	Project   *domain.Project
	ProjectID uuid.UUID
	Calls     []domain.NetworkCall
	Filter    domain.NetworkFilter
	// Selected is the call whose phases are loaded, and Phases are its logs:
	// every phase, and the first LinkedLogLimit of the app's own. Both nil when
	// the list is empty or nothing has been picked.
	Selected *domain.NetworkCall
	Phases   []domain.Log
	// LinkedTotal counts every log the app linked to the call, including the
	// ones Phases leaves out.
	LinkedTotal int
	// Uncaptured is a request id with no row in the list because none of its
	// phases were stored, only the app's own logs, which are then in Phases.
	// Set only when Selected is nil.
	Uncaptured *uuid.UUID
	// Phase is which tab of the selected call is open: "headers", "payload",
	// "response" or "error".
	Phase string
	// SessionStart is when the launch began, and is set only when the list is
	// one session. It is what the "since launch" column counts from.
	SessionStart time.Time
}

func (d NetworkData) shell() ProjectShellData {
	return ProjectShellData{User: d.User, ProjectID: d.ProjectID, Project: d.Project, Active: "network"}
}

templ NetworkPage(d NetworkData) {
	@ProjectShell(d.shell()) {
		<div class="flex flex-wrap items-baseline justify-between gap-2">
			<h1 class="text-xl font-bold text-white">Network</h1>
			<span class="text-xs text-cs-muted">{ callsSummary(d.Calls) }</span>
		</div>
		<p class="mt-1 text-sm text-cs-muted">Every request, response and error, paired back into one row per call.</p>
		@networkToolbar(d)
		// A call that was not captured has no row, so an empty list is no
		// reason to hide its pane. An app at the default minimumLevel stores
		// no network logs at all, so for that app the list is always empty.
		if len(d.Calls) == 0 && d.Uncaptured == nil {
			@networkEmpty(d.Filter)
		} else {
			<!-- The split. One column below 1100px, where 400px of detail beside
			     a table would leave neither anything to work with.

			     On xl the whole split gets a fixed height so each side scrolls
			     inside itself, the way DevTools does. Without it the pane grows
			     to fit twenty-five response headers, the page scroll bar becomes
			     the pane's scroll bar, and the toolbar and the list scroll away
			     while you read. Below xl there is no second column to keep in
			     view, so it flows and the page scrolls normally. -->
			<div class="mt-4 grid min-h-[440px] grid-cols-1 overflow-hidden rounded-xl border border-cs-border xl:h-[calc(100vh-15rem)] xl:grid-cols-[1fr_420px]">
				<div class="min-w-0 overflow-auto border-cs-border xl:border-r">
					@networkListOrNone(d)
				</div>
				@NetworkDetailPane(d)
			</div>
			@NetworkCopyScript()
		}
	}
}

// Beside a call that was not captured the list can be empty, and an empty
// table reads as a rendering bug. The pages' own empty states would be wrong
// there: one says to add an interceptor, which is where the request id came
// from, and the other says the launch made no calls, when it made this one.
templ networkListOrNone(d NetworkData) {
	if len(d.Calls) == 0 {
		<p data-network-none class="p-8 text-center text-xs text-cs-muted">{ noCallsStored(d) }</p>
	} else {
		@networkList(d)
	}
}

// A plain GET form: no hx- anything. Submitting it reloads the page with the
// filter in the query string, which is exactly what a filter should do, and it
// keeps working with JavaScript switched off.
templ networkToolbar(d NetworkData) {
	<form method="get" data-network-toolbar class="mt-4 flex flex-wrap items-center gap-2">
		<input
			type="search"
			name="path"
			value={ d.Filter.Path }
			placeholder="Filter by path"
			class="min-w-[180px] flex-1 rounded-lg border border-cs-border bg-chinese-black px-3 py-1.5 font-mono text-xs text-white placeholder:text-cs-placeholder focus:border-cs-primary focus:outline-none"
		/>
		@networkSelect("method", "Any method", d.Filter.Method, domain.HTTPMethods)
		@networkSelect("status", "Any status", d.Filter.Status, domain.StatusClasses)
		<button
			type="submit"
			class="rounded-lg border border-cs-border px-3 py-1.5 text-xs text-white transition-colors hover:border-cs-primary/50 hover:text-cs-primary"
		>Apply</button>
		if !d.Filter.IsEmpty() {
			<a
				href={ templ.SafeURL(fmt.Sprintf("/project/%s/network", d.ProjectID)) }
				class="text-xs text-cs-muted no-underline transition-colors hover:text-white"
			>Clear</a>
		}
	</form>
}

// A native select, not a scripted dropdown. The prototype draws "Any method ▾",
// which is what a select already is on every platform, including with a
// keyboard and a screen reader.
templ networkSelect(name string, anyLabel string, selected string, options []string) {
	<select
		name={ name }
		class="rounded-lg border border-cs-border bg-chinese-black px-3 py-1.5 text-xs text-white focus:border-cs-primary focus:outline-none"
	>
		<option value="" selected?={ selected == "" }>{ anyLabel }</option>
		for _, opt := range options {
			<option value={ opt } selected?={ selected == opt }>{ opt }</option>
		}
	</select>
}

// Two column sets over one list, because a launch and a project are asking
// different questions. A project's list wants the waterfall: where each call sat
// in the window and how long it took, which a column of timestamps cannot show.
// A launch already is a window, so it wants the clock and the distance from the
// launch instead — "what happened first, and how long after the app opened".
templ networkList(d NetworkData) {
	<table
		class={ "w-full border-collapse text-sm",
			templ.KV("min-w-[620px]", d.launchScoped()),
			templ.KV("min-w-[560px]", !d.launchScoped()) }
	>
		<thead>
			<tr class="border-b border-cs-border text-left text-[10px] font-semibold uppercase tracking-wider text-cs-placeholder">
				if d.launchScoped() {
					<th class="px-3 py-2 font-semibold">Time</th>
					<th class="whitespace-nowrap px-3 py-2 text-right font-semibold">Since launch</th>
				}
				<th class="px-3 py-2 font-semibold">Method</th>
				<!-- w-full on this one column, so an auto-layout table gives it
				     every pixel the fixed columns did not want. Without it the
				     leftover lands on whichever column comes first, and the path
				     truncates to nothing while a timestamp sits in a third of
				     the table. -->
				<th class="w-full px-3 py-2 font-semibold">Path</th>
				<th class="px-3 py-2 font-semibold">Status</th>
				if d.launchScoped() {
					<th class="px-3 py-2 text-right font-semibold">Took</th>
				} else {
					<th class="px-3 py-2 text-right font-semibold">Time</th>
					<th class="w-[150px] px-3 py-2 font-semibold">Waterfall</th>
				}
			</tr>
		</thead>
		@networkRows(d, false)
	</table>
}

// The rows again, for HTMX to swap out of band.
//
// Selecting a row changes two places at once: the pane on the right, and which
// row is lit up on the left. hx-target can only name one, so the response
// carries the other with it. hx-swap-oob="true" means "this element is not the
// thing that was asked for — find the element with the same id on the page and
// replace it", which HTMX does after handling the main swap.
//
// It has to be a tbody, and the tbody has to be wrapped in a template. A
// browser throws away a bare <tbody> when parsing a fragment, because a tbody
// is only valid inside a table; <template> is the one element whose contents
// are parsed without that rule. Swapping the tbody rather than the surrounding
// div is also what keeps the list's scroll position, which matters once the
// list is its own scroll container.
templ NetworkRowsOOB(d NetworkData) {
	<template>
		@networkRows(d, true)
	</template>
}

// One body for both, so the swapped-in rows can never come back with a
// different set of columns from the ones they replace.
templ networkRows(d NetworkData, oob bool) {
	{{ start, span := callWindow(d.Calls) }}
	{{ launch := d.launchStart() }}
	<tbody
		id="network-rows"
		if oob {
			hx-swap-oob="true"
		}
		class="divide-y divide-cs-border"
	>
		for _, call := range d.Calls {
			@networkRow(d, call, start, span, launch)
		}
	</tbody>
}

// The row swaps the detail pane in place. hx-target names the pane, hx-swap
// outerHTML replaces the whole thing (the pane's own header changes too, not
// just its contents), and hx-push-url writes the page address the selection
// corresponds to — so a refresh or a paste lands on the same call.
// The control is the anchor in the Path cell, not the row.
//
// The row used to carry hx-get on the <tr> itself, which a mouse fires and a
// keyboard never can: a <tr> is not focusable and htmx's default trigger is
// `click`. The inspector is the whole right-hand pane and there was no way to
// reach it without a pointer, against DESIGN.md's "all actions reachable via
// Tab + Enter" and NET-14. Sessions and Devices already put their links in
// cells, for the same reason a row cannot be an anchor.
//
// The ::after stretches that anchor over the whole row so clicking the status
// chip or the bar at the end still works, the same idiom ProjectCard uses to
// keep a card clickable while its star stays a real button. It needs z-10:
// cells after this one paint over an auto-z pseudo-element.
//
// aria-selected went with the hx. It means nothing on a <tr> outside a grid
// role, so it announced nothing; the anchor carries aria-current instead.
//
// A Go comment rather than an HTML one because this renders once per row, and
// 200 rows of commentary is 200 copies of it on the wire.
templ networkRow(d NetworkData, call domain.NetworkCall, start time.Time, span time.Duration, launch time.Time) {
	{{ selected := d.Selected != nil && d.Selected.RequestID == call.RequestID }}
	<tr
		data-network-row
		data-request={ call.RequestID.String() }
		class={ "relative transition-colors hover:bg-eerie-black/40",
			templ.KV("bg-eerie-black/60", selected) }
	>
		if d.launchScoped() {
			<td class="whitespace-nowrap px-3 py-2 font-mono text-[11px] tabular-nums text-cs-muted">
				{ fmtTime(call.StartedAt, TimeMillis) }
			</td>
			<td class="whitespace-nowrap px-3 py-2 text-right font-mono text-[11px] tabular-nums text-cs-placeholder">
				{ offsetLabel(call.StartedAt, launch) }
			</td>
		}
		<td class="px-3 py-2">
			<span class={ "font-mono text-[11px] font-semibold", methodClass(call.Method) }>{ methodLabel(call.Method) }</span>
		</td>
		<td class="max-w-0 px-3 py-2">
			<a
				href={ templ.SafeURL(d.pageHref(call.RequestID, "")) }
				hx-get={ d.fragmentHref(call.RequestID, "") }
				hx-target="#network-detail"
				hx-swap="outerHTML"
				hx-push-url={ d.pageHref(call.RequestID, "") }
				data-network-open
				if selected {
					aria-current="page"
				}
				title={ derefLabel(call.URL, "") }
				class="block truncate font-mono text-xs text-white no-underline after:absolute after:inset-0 after:z-10 after:content-[''] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-cs-primary"
			>{ call.Path() }</a>
		</td>
		<td class="px-3 py-2">@statusChip(call)</td>
		<td class="whitespace-nowrap px-3 py-2 text-right font-mono text-[11px] tabular-nums text-cs-muted">{ durationLabel(call) }</td>
		if !d.launchScoped() {
			<td class="px-3 py-2">@waterfall(call, start, span)</td>
		}
	</tr>
}

// The waterfall is where each call sat in the window the list covers, and how
// long it took. It is the one thing a table of timestamps cannot show: a slow
// call and a call that started late look identical in a Time column.
templ waterfall(call domain.NetworkCall, start time.Time, span time.Duration) {
	{{ offset, width := waterfallBar(call, start, span) }}
	<!-- min-w on the track, not a width on the column.
	     The table is auto layout and Path carries w-full, which claims every
	     spare pixel, so the `w-[150px]` on the header is only ever a hint and
	     this column collapsed to the width of the word "Waterfall": 62px, at
	     every viewport. A minimum on the content is what an auto table actually
	     honours. 126px is what the prototype draws.

	     The track is visible on purpose. At cs-border/40 it composited to
	     #1B1C1F on a #17181C card, which is 1.04:1 against its own background:
	     there was no track, only a floating bar, so a call that started late and
	     one that ran long looked identical. -->
	<div class="relative h-1.5 w-full min-w-[126px] overflow-hidden rounded-full bg-cs-muted/[0.12]">
		<span
			style={ fmt.Sprintf("left:%.1f%%;width:%.1f%%", offset, width) }
			class={ "absolute inset-y-0 min-w-[3px] rounded-full",
				templ.KV("bg-cs-danger", call.Failed()),
				templ.KV("bg-cs-primary/70 animate-pulse", call.State() == domain.CallPending),
				templ.KV("bg-cs-primary/70", !call.Failed() && call.State() != domain.CallPending) }
		></span>
	</div>
}

templ statusChip(call domain.NetworkCall) {
	<span
		class={ "inline-flex rounded-full px-2 py-0.5 font-mono text-[10px] font-bold",
			templ.KV("bg-[rgba(248,81,73,0.15)] text-[#F85149]", call.Failed()),
			templ.KV("bg-[rgba(210,153,34,0.15)] text-[#D29922]", !call.Failed() && call.State() == domain.CallPending),
			templ.KV("bg-[rgba(63,185,80,0.15)] text-[#3FB950]", !call.Failed() && call.State() != domain.CallPending) }
	>{ call.StatusLabel() }</span>
}

// The detail pane. Its id is what every row targets, and it carries that id
// whether or not anything is selected — an hx-target that does not exist is a
// click that silently does nothing.
templ NetworkDetailPane(d NetworkData) {
	<div id="network-detail" class="flex min-h-0 min-w-0 flex-col border-t border-cs-border xl:border-t-0">
		if d.Selected == nil && d.Uncaptured != nil {
			@uncapturedCall(d, *d.Uncaptured)
		} else if d.Selected == nil {
			<div class="grid h-full place-items-center p-8 text-center text-xs text-cs-muted">
				Select a call to inspect it
			</div>
		} else {
			<div class="border-b border-cs-border p-4">
				<div class="flex items-center gap-2">
					<span class={ "font-mono text-[11px] font-semibold", methodClass(d.Selected.Method) }>{ methodLabel(d.Selected.Method) }</span>
					@statusChip(*d.Selected)
					<span class="ml-auto font-mono text-[11px] text-cs-muted">{ durationLabel(*d.Selected) }</span>
					@dismissButton(d)
				</div>
				<p class="mt-2 break-all font-mono text-xs text-white">{ d.Selected.Path() }</p>
				if host := d.Selected.Host(); host != "" {
					<p class="mt-0.5 font-mono text-[10px] text-cs-muted">{ host }</p>
				}
			</div>
			// Above the tabs rather than in one, so a log about the body stays
			// in view beside whichever phase is open.
			@paneLinkedLogs(d.ProjectID, d.Selected.RequestID, d.Phases, d.LinkedTotal)
			@phaseTabs(d)
			<!-- min-h-0 is load-bearing. A flex child defaults to min-height:auto,
			     which refuses to shrink below its content, so overflow-y-auto here
			     would never have anything to scroll and the pane would push the
			     page taller instead. -->
			<div class="min-h-0 flex-1 overflow-y-auto p-4">
				@phaseBody(d)
			</div>
			@paneFooter(d)
		}
	</div>
}

templ paneLinkedLogs(projectID uuid.UUID, requestID uuid.UUID, logs []domain.Log, linkedTotal int) {
	if _, linked := domain.SplitCallLogs(logs); len(linked) > 0 {
		<section data-linked-logs aria-label="Logged by the app" class="shrink-0 border-b border-cs-border px-4 pb-3 pt-2.5">
			<h5 class="mb-1 flex items-baseline gap-2 text-[10px] font-bold uppercase tracking-wider text-cs-placeholder">
				Logged by the app
				@linkedLogsCount(len(linked), linkedTotal)
			</h5>
			@linkedLogRows(linked)
			@requestLogsLink(projectID, requestID)
		</section>
	}
}

// No method, path, status or tabs: nothing that would say them was stored.
templ uncapturedCall(d NetworkData, requestID uuid.UUID) {
	<div class="border-b border-cs-border p-4">
		<div class="flex items-center justify-between gap-2">
			<span class="inline-flex rounded-full bg-[rgba(210,153,34,0.15)] px-2 py-0.5 font-mono text-[10px] font-bold text-[#D29922]">call not captured</span>
			@dismissButton(d)
		</div>
		<p class="mt-2 break-all font-mono text-[10px] text-cs-muted">request { requestID.String() }</p>
	</div>
	@paneLinkedLogs(d.ProjectID, requestID, d.Phases, d.LinkedTotal)
	<div class="min-h-0 flex-1 overflow-y-auto p-4">
		<p data-call-not-captured class="text-xs leading-relaxed text-cs-muted">{ domain.CallNotCaptured }</p>
	</div>
}

// A message and an error are whatever the app wrote, so both stay text.
templ linkedLogRows(linked []domain.Log) {
	<div class="divide-y divide-cs-border/60">
		for _, l := range linked {
			<div data-linked-log class="grid grid-cols-[auto_auto_minmax(0,1fr)] items-center gap-x-2.5 gap-y-1 py-1.5">
				<span class="font-mono text-[11px] tabular-nums text-cs-muted">{ fmtTime(l.TimeStamp, TimeSeconds) }</span>
				<span>@LogLevelBadge(l.Level)</span>
				<span class="truncate text-xs text-white" title={ l.Message }>{ l.Message }</span>
				if l.Error != nil && *l.Error != "" {
					<span class="col-span-full line-clamp-3 break-words font-mono text-[11.5px] text-cs-danger">{ *l.Error }</span>
				}
			</div>
		}
	</div>
}

templ linkedLogsCount(listed, linkedTotal int) {
	if shown := linkedLogsShown(listed, linkedTotal); shown != "" {
		<span data-linked-logs-count class="font-mono font-normal normal-case tracking-normal text-cs-muted">{ shown }</span>
	}
}

templ requestLogsLink(projectID uuid.UUID, requestID uuid.UUID) {
	<a
		data-linked-logs-all
		href={ templ.SafeURL(requestLogsHref(projectID, requestID)) }
		class="mt-1.5 inline-block font-mono text-[11px] text-cs-primary no-underline hover:underline"
	>Every log for this call</a>
}

// Closing goes back to the same list with nothing selected — the same request
// the pane already knows how to answer, just without an rid. hx-push-url drops
// it from the address bar too, so a reload does not reopen what you closed.
//
// With no list, a call that was not captured is all the split holds, and the
// pane swapped in would ask you to select a call from nothing. Closing it is a
// link to the page without it instead, which is the empty state.
templ dismissButton(d NetworkData) {
	if len(d.Calls) == 0 {
		<a
			href={ templ.SafeURL(d.pageHref(uuid.Nil, "")) }
			data-dismiss-inspector
			aria-label="Close the inspector"
			class="-mr-1 ml-1 rounded p-1 leading-none text-cs-muted no-underline transition-colors hover:bg-eerie-black hover:text-white"
		>&times;</a>
	} else {
		<button
			type="button"
			data-dismiss-inspector
			aria-label="Close the inspector"
			hx-get={ d.fragmentHref(uuid.Nil, "") }
			hx-target="#network-detail"
			hx-swap="outerHTML"
			hx-push-url={ d.pageHref(uuid.Nil, "") }
			class="-mr-1 ml-1 rounded p-1 leading-none text-cs-muted transition-colors hover:bg-eerie-black hover:text-white"
		>&times;</button>
	}
}

// Outside the scrolling body, so the call's identity stays put while you read.
//
// The way out to the launch is only offered when you are not already in it.
templ paneFooter(d NetworkData) {
	<div class="border-t border-cs-border px-4 py-2">
		<p class="truncate font-mono text-[10px] text-cs-muted">request { d.Selected.RequestID.String() }</p>
		if !d.launchScoped() {
			<a
				href={ templ.SafeURL(fmt.Sprintf("/project/%s/session/%s", d.ProjectID, d.Selected.SessionID)) }
				class="font-mono text-[10px] text-cs-primary no-underline hover:underline"
			>open the session timeline</a>
		}
	</div>
}

// Only the tabs that have something behind them. A Response tab on a call that
// never came back is a tab that can only ever say "nothing here".
templ phaseTabs(d NetworkData) {
	<div class="flex gap-1 border-b border-cs-border px-2">
		for _, phase := range AvailableTabs(d.Phases) {
			<a
				href={ templ.SafeURL(d.pageHref(d.Selected.RequestID, phase)) }
				hx-get={ d.fragmentHref(d.Selected.RequestID, phase) }
				hx-target="#network-detail"
				hx-swap="outerHTML"
				hx-push-url={ d.pageHref(d.Selected.RequestID, phase) }
				data-phase-tab={ phase }
				if phase == d.Phase {
					aria-current="page"
				}
				class={ "border-b-2 px-3 py-2 text-xs no-underline transition-colors",
					templ.KV("border-cs-primary text-white", phase == d.Phase),
					templ.KV("border-transparent text-cs-muted hover:text-white", phase != d.Phase) }
			>{ tabLabel(phase) }</a>
		}
	</div>
}

templ phaseBody(d NetworkData) {
	switch d.Phase {
		case "headers":
			@headersTab(d)
		case "payload":
			@bodyTab(d, "request", "Request body")
		case "response":
			@bodyTab(d, "response", "Response body")
		case "error":
			@errorTab(d)
		default:
			<p class="text-xs text-cs-muted">Nothing was recorded for this call.</p>
	}
}

// Both directions on one screen, which is the only way to compare them — and
// the reason this is its own tab rather than the first thing between you and
// every response body you open.
templ headersTab(d NetworkData) {
	{{ req := phaseLog(d.Phases, "request") }}
	{{ res := phaseLog(d.Phases, "response") }}
	if req != nil {
		{{ h := mapField(decodeMeta(req.Metadata), "headers") }}
		if len(h) > 0 {
			@kvSection("Request headers", sortedKV(h), false)
		} else {
			@emptyNote("Request headers", "The request carried none.")
		}
	}
	if res != nil {
		{{ h := mapField(decodeMeta(res.Metadata), "headers") }}
		if len(h) > 0 {
			@kvSection("Response headers", sortedKV(h), false)
		} else {
			@emptyNote("Response headers", "The response carried none.")
		}
	} else if phaseLog(d.Phases, "error") != nil {
		@emptyNote("Response headers", "The call failed, so there was never a response.")
	} else {
		@emptyNote("Response headers", "Still waiting for the response.")
	}
}

templ bodyTab(d NetworkData, phase string, title string) {
	{{ log := phaseLog(d.Phases, phase) }}
	if log == nil {
		<p class="text-xs text-cs-muted">This phase was never recorded.</p>
	} else if body := rawField(decodeMeta(log.Metadata), "body"); body != "" {
		@preSection(title, body)
	} else {
		@emptyNote(title, "Empty.")
	}
}

templ errorTab(d NetworkData) {
	{{ log := phaseLog(d.Phases, "error") }}
	if log == nil {
		<p class="text-xs text-cs-muted">This call did not fail.</p>
	} else {
		{{ meta := decodeMeta(log.Metadata) }}
		@kvSection("Exception", []kv{
			{"type", stringField(meta, "type")},
			{"message", stringField(meta, "message")},
			{"occurred at", fmtTime(log.TimeStamp, DateTimeMillis)},
		}, true)
		if trace := stringField(meta, "stack_trace"); trace != "" {
			@preSection("Stack trace", trace)
		}
	}
}

// Says the section exists and is empty, rather than leaving a gap you cannot
// tell from a rendering bug.
templ emptyNote(title string, note string) {
	<h5 class="mb-2 text-[10px] font-bold uppercase tracking-wider text-cs-placeholder">{ title }</h5>
	<p class="mb-4 text-[11.5px] text-cs-muted">{ note }</p>
}

type kv struct {
	Key   string
	Value string
}

templ kvSection(title string, rows []kv, danger bool) {
	<h5 class="mb-2 text-[10px] font-bold uppercase tracking-wider text-cs-placeholder">{ title }</h5>
	<dl class="mb-4 grid grid-cols-[110px_1fr] gap-x-3 gap-y-1 text-[11.5px]">
		for _, row := range rows {
			<dt class="truncate font-mono text-cs-muted">{ row.Key }</dt>
			if isRedacted(row.Value) {
				@redactedValue()
			} else {
				<dd class={ "min-w-0 break-all font-mono",
					templ.KV("text-cs-danger", danger && row.Key == "type"),
					templ.KV("text-white", !(danger && row.Key == "type")) }
				>{ row.Value }</dd>
			}
		}
	</dl>
}

// A redacted value reads as a deliberate absence, not as content. The SDK
// replaced it before the request ever left the device, so there is nothing
// here to reveal — saying so is the point.
templ redactedValue() {
	<dd data-redacted class="min-w-0 font-mono text-[#D29922]">
		••••••
		<span class="ml-1 text-[10px] text-cs-muted">redacted on the device</span>
	</dd>
}

templ preSection(title string, body string) {
	<div data-copy-block class="mb-4">
		<div class="mb-2 flex items-center justify-between gap-2">
			<h5 class="text-[10px] font-bold uppercase tracking-wider text-cs-placeholder">{ title }</h5>
			@copyButton(title)
		</div>
		<pre class="max-h-[280px] overflow-auto whitespace-pre-wrap rounded-lg border border-cs-border bg-chinese-black p-3 font-mono text-[11.5px] text-cs-muted">{ body }</pre>
	</div>
}

// The body is read out of the <pre> next to the button rather than written into
// the page a second time as a JS string. A response body is whatever the app
// was sent, so quoting it into a script is a way to get someone else's JSON
// executing in your dashboard.
templ copyButton(what string) {
	<button
		type="button"
		data-copy
		title={ "Copy the " + strings.ToLower(what) }
		aria-label={ "Copy the " + strings.ToLower(what) }
		class="flex shrink-0 items-center gap-1 rounded border border-cs-border px-1.5 py-0.5 text-[10px] text-cs-muted transition-colors hover:border-cs-primary/50 hover:text-cs-primary"
	>
		<svg data-copy-icon width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<rect x="9" y="9" width="13" height="13" rx="2"></rect>
			<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
		</svg>
		<span data-copy-label>Copy</span>
	</button>
}

// Bound to the document, not to the buttons.
//
// The inspector is replaced wholesale by every row click and every tab, so a
// listener attached to a button dies with the first swap and copying silently
// stops working. The document survives all of it, and the click bubbles up to
// it from whatever is on the page at the time.
templ NetworkCopyScript() {
	<script>
		function csCopyDone(button, text) {
			var label = button.querySelector('[data-copy-label]');
			if (!label) return;
			var previous = label.textContent;
			label.textContent = text;
			setTimeout(function() { label.textContent = previous; }, 1200);
		}

		document.addEventListener('click', function(e) {
			var button = e.target.closest && e.target.closest('[data-copy]');
			if (!button) return;

			var block = button.closest('[data-copy-block]');
			var pre = block && block.querySelector('pre');
			if (!pre) return;

			// navigator.clipboard needs a secure context, and a self-hosted
			// instance is often plain http on a LAN address — where it is not
			// merely blocked but undefined. The old selection-based copy is
			// deprecated and still the only thing that works there.
			if (navigator.clipboard && window.isSecureContext) {
				navigator.clipboard.writeText(pre.textContent).then(
					function() { csCopyDone(button, 'Copied'); },
					function() { csCopyDone(button, 'Failed'); });
				return;
			}

			var scratch = document.createElement('textarea');
			scratch.value = pre.textContent;
			// Off-screen rather than hidden: a display:none textarea cannot be
			// selected, so the copy silently does nothing.
			scratch.style.position = 'fixed';
			scratch.style.left = '-9999px';
			document.body.appendChild(scratch);
			scratch.select();
			var ok = false;
			try { ok = document.execCommand('copy'); } catch (err) { ok = false; }
			document.body.removeChild(scratch);
			csCopyDone(button, ok ? 'Copied' : 'Failed');
		});
	</script>
}

templ networkEmpty(f domain.NetworkFilter) {
	<div class="mt-4 flex flex-col items-center gap-2 rounded-xl border border-cs-border py-16 text-center">
		if f.IsEmpty() {
			<p class="text-lg font-bold tracking-[0.18px] text-white">No network calls yet</p>
			<p class="text-sm tracking-[0.14px] text-cs-muted">
				Add the Dio interceptor or the HTTP client wrapper and every call shows up here.
			</p>
		} else {
			<p class="text-lg font-bold tracking-[0.18px] text-white">Nothing matches that filter</p>
			<p class="text-sm tracking-[0.14px] text-cs-muted">Try a shorter path, or clear the filter.</p>
		}
	</div>
}
